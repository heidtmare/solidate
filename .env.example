# Owner/superuser connection. Used for migrations and by #[sqlx::test] to create test databases.
DATABASE_URL=postgres://solidate:solidate@localhost:5433/solidate

# Server (solidate-server). HOST/PORT default to 127.0.0.1:3000.
# SOLIDATE_PUBLIC_URL=http://localhost:3000
# SOLIDATE_INSECURE_COOKIES=1

# OpenID Connect single sign-on (off unless SOLIDATE_OIDC_ISSUER is set). The
# redirect URL defaults to $SOLIDATE_PUBLIC_URL/login/oidc/callback.
# SOLIDATE_OIDC_ISSUER=https://accounts.example.com
# SOLIDATE_OIDC_CLIENT_ID=solidate
# SOLIDATE_OIDC_CLIENT_SECRET=
# SOLIDATE_OIDC_REDIRECT_URL=
# SOLIDATE_OIDC_SCOPES=email profile
# SOLIDATE_OIDC_LABEL=SSO

# Per-token API rate limit (REST and MCP). 0 disables. Defaults: 600/min, burst 60.
# SOLIDATE_RATE_LIMIT_PER_MIN=600
# SOLIDATE_RATE_LIMIT_BURST=60

# Logging (stderr). RUST_LOG filter; SOLIDATE_LOG_FORMAT=json for JSON lines.
# RUST_LOG=info,sqlx=warn
# SOLIDATE_LOG_FORMAT=json
